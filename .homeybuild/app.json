{
  "_comment": "This file is generated. Please edit .homeycompose/app.json instead.",
  "id": "com.allard.tuisssmartview",
  "version": "0.1.7",
  "compatibility": ">=12.0.0",
  "sdk": 3,
  "runtime": "nodejs",
  "platforms": [
    "local"
  ],
  "brandColor": "#436B75",
  "name": {
    "en": "Tuiss SmartView BLE",
    "nl": "Tuiss SmartView BLE"
  },
  "description": {
    "en": "Control Tuiss SmartView blinds directly over Bluetooth",
    "nl": "Bedien Tuiss SmartView raamdecoratie rechtstreeks via Bluetooth"
  },
  "category": "appliances",
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png"
  },
  "permissions": [
    "homey:wireless:ble"
  ],
  "author": {
    "name": "Allard van Berkel"
  },
  "drivers": [
    {
      "name": {
        "en": "SmartView blind",
        "nl": "SmartView raamdecoratie"
      },
      "class": "blinds",
      "capabilities": [
        "windowcoverings_set",
        "windowcoverings_state"
      ],
      "connectivity": [
        "ble"
      ],
      "images": {
        "small": "/drivers/blind/assets/images/small.png",
        "large": "/drivers/blind/assets/images/large.png"
      },
      "pair": [
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "id": "blind",
      "settings": [
        {
          "id": "invertDirection",
          "type": "checkbox",
          "label": {
            "en": "Reverse direction",
            "nl": "Richting omkeren"
          },
          "hint": {
            "en": "Swap open and closed for this blind in Homey.",
            "nl": "Verwissel open en dicht voor dit gordijn in Homey."
          },
          "value": false
        }
      ]
    }
  ]
}